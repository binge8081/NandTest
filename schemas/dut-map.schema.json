{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfa1000.local/schemas/dut-map.schema.json",
  "title": "NFA1000 DUT map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targets"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "source": { "type": ["string", "null"] },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane", "channel", "ce", "lun"],
        "properties": {
          "lane": { "type": "integer", "minimum": 0 },
          "channel": { "type": "integer", "minimum": 0 },
          "ce": { "type": "integer", "minimum": 0 },
          "lun": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
